{
  "manifest_version": 3,
  "name": "Simple Header Editor",
  "version": "1.0.0",
  "description": "Inject custom HTTP request headers based on domain patterns configured via JSON.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "simple-header-editor@mgm-tp.com",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simple Header Editor",
    "default_icon": {
      "128": "icons/icon.png"
    }
  }
}
